; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Fmod]

General/banks_path="res://FmodBanks/Desktop"

[application]

config/name="ScreamJam2025"
run/main_scene="res://Assets/World/World.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://Assets/Global/Game.gd"
Inventory="*res://Assets/Global/Inventory.gd"
FmodManager="*res://addons/fmod/FmodManager.gd"
LightArea2DManager="*res://Assets/Global/LightArea2DManager.gd"

[display]

window/stretch/mode="viewport"
window/per_pixel_transparency/allowed=true

[editor_plugins]

enabled=PackedStringArray("res://addons/fmod/plugin.cfg")

[global_group]

World=""
Door=""
"Red Generator"=""
"Item Log"=""
Player=""
Vanishing=""
UI=""

